{
  "name": "pi-cursor-embedded-compat",
  "version": "0.1.0",
  "description": "Guarded Pi compatibility shim for Cursor SDK module resolution in embedded hosts.",
  "type": "module",
  "license": "MIT",
  "author": "Keisuke",
  "keywords": [
    "pi",
    "pi-package",
    "cursor",
    "embedded-host",
    "module-interop",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eiei114/pi-cursor-embedded-compat"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-cursor-embedded-compat/issues"
  },
  "homepage": "https://github.com/eiei114/pi-cursor-embedded-compat#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "publish:guard": "node scripts/check-no-npm-token.mjs",
    "canary:live": "node --experimental-strip-types scripts/live-canary.mjs",
    "ci": "npm run typecheck && npm test && npm run pack:check && npm run publish:guard"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
